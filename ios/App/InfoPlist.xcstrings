    "NSGKFriendListUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لعرض أصدقائك في Game Center الذين يلعبون Brass Pawn ودعوتهم إلى مباراة."
          }
        },
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لعرض أصدقائك في Game Center الذين يلعبون Brass Pawn ودعوتهم إلى مباراة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За да покажете на приятелите си в Game Center, които играят Brass Pawn, и да ги поканите на партия."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn ব্যবহার করা Game Center-এর বন্ধুদের দেখাতে, এবং তাদেরকে একটি গেমে আমন্ত্রণ জানাতে।"
          }
        },
        "bn-BD": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass Pawn ব্যবহার করা Game Center-এর বন্ধুদের দেখাতে, এবং তাদেরকে একটি গেমে আমন্ত্রণ জানাতে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per mostrar als vostres amics de Game Center que juguen a Brass Pawn, i convidar-los a una partida."
          }
